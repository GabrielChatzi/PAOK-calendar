{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "docs",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/metavivaseis/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/metavivaseis/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/archive/:f",
      "destination": "/api/data?f=archive/:f"
    },
    {
      "source": "/crests/:f",
      "destination": "/api/data?f=crests/:f"
    },
    {
      "source": "/:name(matches|standings|status|events).json",
      "destination": "/api/data?f=:name.json"
    },
    {
      "source": "/paok.ics",
      "destination": "/api/cal?t=all&v=all"
    },
    {
      "source": "/cal.ics",
      "destination": "/api/cal"
    },
    {
      "source": "/:name.ics",
      "destination": "/api/data?f=:name.ics"
    }
  ]
}
